# Notion internal integration token (keep private)
NOTION_TOKEN=your_notion_integration_token
# ID of the Notion page you created and shared with the integration
NOTION_PARENT_PAGE_ID=3f4cf65e-92d7-8035-8664-cd36dd8a1296
# Comma-separated seasons to sync, e.g. 2024,2025,2026
F1_SEASONS=2024,2025,2026
# Optional: API version used by the Notion public API
NOTION_VERSION=2022-06-28
